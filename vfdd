#!/usr/bin/env python3
"""vfdd - own the X98H front display; show the clock unless someone claims it.

Everything else talks to this daemon over /run/x98h-vfd.sock (JSON per line):

    {"op":"show","text":"HELLO","scroll":true,"delay":0.30,
     "loops":3,"duration":null,"hold":false,"bright":7,
     "icons":[],"priority":10}
    {"op":"release"}          drop the current message, return to the clock
    {"op":"status"}

Semantics
  hold=true   stay on screen until someone sends release (or a higher priority)
  loops=N     scroll the text N times, then yield to the clock
  duration=S  give up the display after S seconds
  priority    0=clock, 10=normal message, 20=alert (preempts normal)

If the daemon is not running the CLI falls back to driving the pins directly.
"""

import json
import os
import selectors
import socket
import subprocess
import time

from x98h_vfd import Vfd, open_lines, render

SOCK = "/run/x98h-vfd.sock"
CLOCK = 0
NORMAL = 10
ALERT = 20
BOOT_SECONDS = 8.0
FAIL_CHECK_EVERY = 30.0
SCROLL_PAD = "    "


class Display:
    def __init__(self):
        self.req = open_lines()
        self.vfd = Vfd(self.req)
        self.msg = None            # active message dict or None
        self.boot_until = time.monotonic() + BOOT_SECONDS
        self.last_fail_check = 0.0
        self.fail_seen = 0

    # ---- message lifecycle -------------------------------------------------
    def claim(self, req):
        prio = int(req.get("priority", NORMAL))
        if self.msg:
            cur = self.msg["priority"]
            # a held message only yields to something genuinely more important
            if prio < cur or (prio == cur and self.msg["hold"]):
                return {"ok": False,
                        "error": f"display held by priority {cur} message"}
        now = time.monotonic()
        duration = req.get("duration")
        self.msg = {
            "text": str(req.get("text", ""))[:512],
            "scroll": bool(req.get("scroll", False)),
            "delay": float(req.get("delay", 0.35)),
            "loops_total": int(req.get("loops") or 0),
            "loops_done": 0,
            "deadline": now + float(duration) if duration else None,
            "hold": bool(req.get("hold", False)),
            "bright": int(req.get("bright", 7)) & 7,
            "icons": list(req.get("icons") or []),
            "priority": prio,
            "index": 0,
            "last_step": 0.0,
        }
        self.boot_until = 0.0
        return {"ok": True}

    def release(self):
        self.msg = None
        return {"ok": True}

    def finished(self, now):
        m = self.msg
        if not m:
            return True
        if m["deadline"] and now >= m["deadline"]:
            return True
        return False

    # ---- rendering --------------------------------------------------------
    def render_message(self, now):
        m = self.msg
        text = m["text"]
        if not text:
            return ["", [], m["bright"]]
        if m["scroll"]:
            framed = SCROLL_PAD + text + SCROLL_PAD
            if now - m["last_step"] >= m["delay"]:
                m["index"] += 1
                m["last_step"] = now
                if m["index"] > len(framed) - 4:
                    m["index"] = 0
                    m["loops_done"] += 1
            chunk = framed[m["index"]:m["index"] + 4]
        else:
            chunk = text[:4]
        return [chunk, m["icons"], m["bright"]]

    def tick(self, now):
        if self.msg and self.finished(now):
            self.msg = None
        if self.msg and self.msg["loops_total"] and \
                self.msg["loops_done"] >= self.msg["loops_total"]:
            self.msg = None

        if self.msg:
            text, icons, bright = self.render_message(now)
            self.vfd.commit(render(text), bright, icons)
            return 0.15

        if now < self.boot_until:
            self.vfd.commit(render("boot"), 7, [])
            return 0.5

        clock = time.strftime("%H%M")
        blink = int(now * 2) % 2 == 1
        self.vfd.commit(render(clock), 7, ["colon"] if blink else [])
        return 0.5

    # ---- failed-unit watcher ---------------------------------------------
    def check_failed(self, now):
        if now - self.last_fail_check < FAIL_CHECK_EVERY:
            return
        self.last_fail_check = now
        try:
            out = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"],
                                 capture_output=True, text=True, timeout=5).stdout
            n = len([l for l in out.splitlines() if l.strip()])
        except Exception:
            return
        if n and (self.msg is None or self.msg["priority"] < ALERT):
            self.claim({"text": f"ERR{n}", "duration": 4.0, "priority": ALERT})
            self.fail_seen = n

    # ---- socket -----------------------------------------------------------
    def handle(self, conn):
        conn.settimeout(2.0)
        try:
            buf = b""
            while not buf.endswith(b"\n") and len(buf) < 8192:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                buf += chunk
            req = json.loads(buf.decode() or "{}")
        except Exception as e:
            try:
                conn.sendall((json.dumps({"ok": False, "error": str(e)}) + "\n").encode())
            except OSError:
                pass
            conn.close()
            return

        op = req.get("op", "show")
        if op == "show":
            resp = self.claim(req)
        elif op == "release":
            resp = self.release()
        elif op == "status":
            resp = {"ok": True, "message": bool(self.msg),
                    "priority": self.msg["priority"] if self.msg else CLOCK}
        else:
            resp = {"ok": False, "error": f"unknown op {op!r}"}
        try:
            conn.sendall((json.dumps(resp) + "\n").encode())
        except OSError:
            pass
        conn.close()


def main():
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)
    srv.listen(8)
    srv.setblocking(False)

    sel = selectors.DefaultSelector()
    sel.register(srv, selectors.EVENT_READ)

    disp = Display()
    next_tick = 0.0
    while True:
        now = time.monotonic()
        timeout = max(0.0, min(0.2, next_tick - now)) if next_tick else 0.2
        for key, _ in sel.select(timeout):
            if key.fileobj is srv:
                try:
                    conn, _ = srv.accept()
                    disp.handle(conn)
                except OSError:
                    pass
        now = time.monotonic()
        disp.check_failed(now)
        if now >= next_tick:
            try:
                interval = disp.tick(now)
            except OSError:
                break
            next_tick = now + max(0.05, interval)


if __name__ == "__main__":
    main()
